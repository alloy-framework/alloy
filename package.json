{
  "name": "alloy",
  "private": true,
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alloy-framework/alloy.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=Infinity build",
    "watch": "tsc --build ./tsconfig.ws.json --watch",
    "change": "chronus",
    "clean": "pnpm -r run clean && rimraf **/.temp/",
    "test": "vitest run",
    "sync-publish-config": "node eng/sync-publish-config.ts",
    "sync-publish-config:check": "node eng/sync-publish-config.ts --check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --disable-nested-config --max-warnings=0",
    "lint:fix": "oxlint --type-aware --disable-nested-config --fix"
  },
  "devDependencies": {
    "@actions/github": "^9.1.1",
    "@alloy-js/cli": "workspace:~",
    "@chronus/chronus": "^1.1.0",
    "@chronus/github": "^1.0.3",
    "@chronus/github-pr-commenter": "^1.0.3",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "execa": "^9.6.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pathe": "^2.0.3",
    "rimraf": "catalog:",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.8",
    "vitest": "catalog:"
  }
}
